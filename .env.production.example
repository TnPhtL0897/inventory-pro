# =============================================================================
# PRODUCTION ENVIRONMENT - KHÔNG commit file này với values thật!
# Copy thành .env.production (local) hoặc set trong hosting provider secrets.
# =============================================================================

# ----- Supabase (cloud) -----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=super-long-random-string

# ----- Database -----
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres

# ----- API (.NET) -----
API_BASE_URL=https://api-inventorypro.fly.dev
NEXT_PUBLIC_API_BASE_URL=https://api-inventorypro.fly.dev
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ----- Web (Next.js) -----
NEXT_PUBLIC_APP_NAME="Quản lý kho vật tư Pro"
NEXT_PUBLIC_APP_VERSION=0.1.0

# ----- Telemetry (optional) -----
# SENTRY_DSN=
