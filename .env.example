# ===== Supabase =====
# Lấy từ Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # CHỈ dùng trong backend, KHÔNG expose ra client
SUPABASE_JWT_SECRET=super-secret-jwt-signing-key  # dùng để validate JWT trên .NET API

# ===== Database (Supabase Postgres) =====
# Connection string dạng postgres://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:password@db.YOUR_PROJECT.supabase.co:5432/postgres

# ===== API (.NET) =====
API_BASE_URL=http://localhost:5000
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# ===== Web (Next.js) =====
NEXT_PUBLIC_APP_NAME="Quản kho"
NEXT_PUBLIC_APP_VERSION=0.1.0

# ===== Cloudflare Pages (auto check build status) =====
# Tạo token: https://dash.cloudflare.com/profile/api-tokens > Create > Edit Cloudflare Pages
# Account ID: Dashboard > Workers & Pages > Project > Overview > Account ID
CF_API_TOKEN=your-cf-api-token
CF_ACCOUNT_ID=your-cf-account-id
CF_PROJECT_NAME=inventory-pro-web

# ===== Telemetry (optional, giai đoạn sau) =====
# SENTRY_DSN=
