# =============================================================================
# PRODUCTION env for Cloudflare Pages build
# =============================================================================
# This file is committed to Git because it only contains NEXT_PUBLIC_*
# values (designed to be public - embedded into the client bundle).
# Secret values (SUPABASE_SERVICE_ROLE_KEY, SUPABASE_JWT_SECRET, etc.)
# must NEVER be added here - they are only set as Cloudflare Pages
# secrets for runtime use in API routes.
#
# Why this file exists:
#   Cloudflare Pages does NOT inject env vars into the build container.
#   next-on-pages runs `vercel build` internally which has no env access.
#   Next.js inlines NEXT_PUBLIC_* into the client bundle at BUILD time,
#   so we must provide values here for the build to succeed.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://ituyoplyuhbdxkhabcpy.supabase.co
